# ==============================================================================
# MONITORING MODULE - ENVIRONMENT VARIABLES
# ==============================================================================
# Description: Module-specific environment defaults for spoke-monitoring
# Author: Matt Barham
# Created: 2026-02-12
# Modified: 2026-04-23
# Version: 1.0.1
# Host: Your Server
# ==============================================================================
# Type: Template
# Security Level: MEDIUM - static IPs and ports; no credentials
# Component: module: monitoring
# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#==========================================================================
# CONTAINER IMAGES
#==========================================================================

# Grafana Alloy observability collector
ALLOY_IMAGE=grafana/alloy:v1.19.2

# Dozzle Docker log viewer
DOZZLE_IMAGE=amir20/dozzle:v10.9.1

# Glances system monitoring
GLANCES_IMAGE=nicolargo/glances:4.5.6-full

# Grafana visualization platform
GRAFANA_IMAGE=grafana/grafana:13.2.1

# Loki log aggregation system
LOKI_IMAGE=grafana/loki:3.7.7

# NUT UPS daemon
NUT_UPSD_IMAGE=instantlinux/nut-upsd:2.8.3-r4

# Prometheus metrics collector (custom build)
PROMETHEUS_TAG=v3.14.0
PROMETHEUS_IMAGE=${INSTANCE_NAME}/prometheus:${PROMETHEUS_TAG}-custom

# Telegraf metrics agent (custom build)
TELEGRAF_TAG=1.39.3
TELEGRAF_IMAGE=${INSTANCE_NAME}/telegraf:${TELEGRAF_TAG}-custom

#==========================================================================
# GRAFANA CONFIGURATION
#==========================================================================

GRAFANA_IP=192.168.35.102
GRAFANA_PORT=3001
GF_SERVER_ROOT_URL=https://graf.${DOMAIN}

#==========================================================================
# LOKI CONFIGURATION
#==========================================================================

LOKI_WRITE_IP=192.168.35.106
LOKI_WRITE_PORT=3102

#==========================================================================
# DOZZLE CONFIGURATION
#==========================================================================

DOZZLE_SOCK_IP=192.168.33.100
DOZZLE_SOCK_PORT=7007
DOZZLE_SOXY_IP=192.168.33.101
DOZZLE_SOXY_PORT=8083

#==========================================================================
# ALLOY CONFIGURATION
#==========================================================================

ALLOY_IP_S=192.168.33.108
ALLOY_IP_T=192.168.35.108
ALLOY_PORT=13351

#==========================================================================
# INFLUXDB3 (from database module)
#==========================================================================

INFLUXDB3_PORT=8181

#==========================================================================
# TELEGRAF CONFIGURATION
#==========================================================================

TELEGRAF_IP_S=192.168.33.104
TELEGRAF_IP_T=192.168.35.104
TELEGRAF_PORT=8096
TELEGRAF_LISTEN_PORT=9222

#==========================================================================
# NUT UPSD CONFIGURATION
#==========================================================================

NUT_IP=192.168.35.110
NUT_PORT=3493
NUT_DRIVER=usbhid-ups
NUT_NAME=apc_ups
NUT_DESCRIPTION=APC Back-UPS BX1000M
NUT_SERIAL=CHANGE_ME
NUT_VENDORID=051d
NUT_DEV_PORT=auto

#==========================================================================
# GLANCES CONFIGURATION (currently disabled)
#==========================================================================

GLANCES_IP_S=192.168.33.103
GLANCES_IP_T=192.168.35.103
GLANCES_PORT=61208
